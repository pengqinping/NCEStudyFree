":"苏菲是法国人。她是一位法国女士。"}]}],"patterns":[{"pattern":"This is + 人名/称谓","explanation":"","original":{"en":"This is Miss Sophie Dupont.","zh":"这是苏菲·杜邦小姐。"},"examples":[{"en":"This is Mr. Wang.","zh":"这是王先生。"},{"en":"This is Tom.","zh":"这是汤姆。"}]},{"pattern":"主语 + is + 国籍形容词","explanation":"","original":{"en":"She is French.","zh":"她是法国人。"},"examples":[{"en":"He is German.","zh":"他是德国人。"},{"en":"She is Japanese.","zh":"她是日本人。"}]},{"pattern":"Is + 主语 + 国籍?","explanation":"","original":{"en":"Is Chang-woo Chinese?","zh":"昌宇是中国人吗？"},"examples":[{"en":"Is she French?","zh":"她是法国人吗？"},{"en":"Is he Korean?","zh":"他是韩国人吗？"}]},{"pattern":"Nice to meet you","explanation":"","original":{"en":"Nice to meet you.","zh":"很高兴认识你。"},"examples":[{"en":"Nice to meet you, Sophie.","zh":"苏菲，很高兴认识你。"},{"en":"Nice to meet you too.","zh":"我也很高兴认识你。"}]}]}
