{"id":"b1-u05","contentId":"nce1:u05","book":1,"unit":5,"key":"009-010","lessonFrom":9,"lessonTo":10,"title":"How Are You Today","titleZh":"你今天好吗？","question":"How is Emma?","vocab":[{"word":"today","phonetic":"/təˈdeɪ/","meanings":[{"pos":"adv.","meaning":"今天","usage":"指说话时的当天"}]},{"word":"well","phonetic":"/wel/","meanings":[{"pos":"adj.","meaning":"健康的；身体好的","usage":"用于描述身体状况"},{"pos":"adv.","meaning":"好；很好地","usage":"修饰动词"}]},{"word":"thanks","phonetic":"/θæŋks/","meanings":[{"pos":"n.","meaning":"谢谢；感谢","usage":"表示感谢的名词复数形式"}]},{"word":"goodbye","phonetic":"/ɡʊdˈbaɪ/","meanings":[{"pos":"interj.","meaning":"再见","usage":"告别时使用的用语"}]},{"word":"see","phonetic":"/siː/","meanings":[{"pos":"v.","meaning":"看见；看到","usage":"表示视觉上的看见"}]},{"word":"fine","phonetic":"/faɪn/","meanings":[{"pos":"adj.","meaning":"很好的；健康的","usage":"口语中表示身体状况好"}]},{"word":"too","phonetic":"/tuː/","meanings":[{"pos":"adv.","meaning":"也；同样","usage":"用于肯定句末，表示也一样"}]},{"word":"how","phonetic":"/haʊ/","meanings":[{"pos":"adv.","meaning":"怎样；如何","usage":"用于询问方式、状态等"}]},{"word":"hello","phonetic":"/həˈləʊ/","meanings":[{"pos":"interj.","meaning":"你好；喂","usage":"打招呼用语"}]},{"word":"nice","phonetic":"/naɪs/","meanings":[{"pos":"adj.","meaning":"美好的；令人愉快的","usage":"形容事物或人令人满意"}]},{"word":"very","phonetic":"/ˈveri/","meanings":[{"pos":"adv.","meaning":"非常；很","usage":"修饰形容词或副词，加强程度"}]},{"word":"and","phonetic":"/ænd/","meanings":[{"pos":"conj.","meaning":"和；而且","usage":"连接并列成分"}]}],"phrases":[{"phrase":"How are you today?","usage":"询问对方今天身体状况的常用问候语","examples":[{"en":"How are you today?","zh":"你今天好吗？"}]},{"phrase":"I'm very well","usage":"回答身体状况，表示非常好/很健康","examples":[{"en":"I'm very well, thank you.","zh":"我非常好，谢谢你。"}]},{"phrase":"And you?","usage":"询问对方情况时的简略表达，常用于回答之后反问对方","examples":[{"en":"I'm fine, thanks. And you?","zh":"我很好，谢谢。你呢？"}]},{"phrase":"How is + 人名?","usage":"询问第三方身体状况的句型","examples":[{"en":"How is Emma?","zh":"Emma 好吗？"}]},{"phrase":"He's/She's fine thanks","usage":"回答第三方状况的常用表达","examples":[{"en":"He's fine, thanks.","zh":"他很好，谢谢。"}]},{"phrase":"Nice to see you","usage":"久别重逢时的问候语，表达见到对方很高兴","examples":[{"en":"Nice to see you.","zh":"很高兴见到你。"}]},{"phrase":"Goodbye","usage":"分别时的告别语","examples":[{"en":"Goodbye, Helen.","zh":"再见，Helen。"}]}],"sentenceCount":14,"exerciseCount":6,"grammarCount":3,"patternCount":4,"sentences":[{"en":"Hello Helen.","zh":"你好，海伦。","t":15.17},{"en":"Hi Steven.","zh":"嗨，史蒂文。","t":17.19},{"en":"How are you today?","zh":"你今天好吗？","t":19.02},{"en":"I'm very well thank you.","zh":"我很好，谢谢。","t":21.69},{"en":"And you?","zh":"你呢？","t":24.28},{"en":"I'm fine thanks.","zh":"我很好，谢谢。","t":25.76},{"en":"How is Tony?","zh":"托尼好吗？","t":28.79},{"en":"He's fine thanks.","zh":"他很好，谢谢。","t":30.8},{"en":"How's Emma?","zh":"艾玛好吗？","t":33.36},{"en":"She's very well too Helen.","zh":"她也很好，海伦。","t":34.95},{"en":"Goodbye Helen.","zh":"再见，海伦。","t":39.2},{"en":"Nice to see you.","zh":"很高兴见到你。","t":40.7},{"en":"Nice to see you too Steven.","zh":"史蒂文，我也很高兴见到你。","t":42.76},{"en":"Goodbye.","zh":"再见。","t":46.17}],"exercises":[{"type":"vocab-choice","kind":"choice","prompt":"“看见；看到” 对应的单词是？","hint":"v. · /siː/","options":["kettle","tomorrow","see","smoke"],"answer":2,"explain":"see · /siː/ · v. · 看见；看到。表示视觉上的看见","source":{"kind":"vocab","word":"see"},"id":"b1-u05-q01"},{"type":"spell","kind":"text","prompt":"根据释义和音标拼写单词：今天","hint":"/təˈdeɪ/ · adv.","answer":"today","placeholder":"输入英文单词","explain":"today · /təˈdeɪ/ · adv. · 今天。指说话时的当天","source":{"kind":"vocab","word":"today"},"id":"b1-u05-q02"},{"type":"phrase-fill","kind":"text","prompt":"补全短语：I'm fine, thanks. _____","hint":"我很好，谢谢。你呢？","answer":"And you?","placeholder":"输入缺失的短语","explain":"And you?：询问对方情况时的简略表达，常用于回答之后反问对方（我很好，谢谢。你呢？）","source":{"kind":"phrase","phrase":"And you?"},"id":"b1-u05-q03"},{"type":"cloze","kind":"text","prompt":"补全句子：She's very _____ too Helen.","hint":"她也很好，海伦。","answer":"well","placeholder":"输入缺失的单词","explain":"She's very well too Helen. — 她也很好，海伦。","source":{"kind":"sentence","en":"She's very well too Helen."},"id":"b1-u05-q04"},{"type":"grammar-choice","kind":"choice","prompt":"“How are you? 是英语中询问他人身体或状况的常用问候语，属于特殊疑问句” 描述的是哪个语法点？","hint":"How + am/is/are + 主语 + (today)?","options":["that引导的宾语从句","情态动词 could 的用法","Can表示允许或能力","How are you? 询问身体状况句型"],"answer":3,"explain":"How are you? 询问身体状况句型：How + am/is/are + 主语 + (today)?：用于日常问候，可根据对象选择 am/is/are","source":{"kind":"grammar","title":"How are you? 询问身体状况句型"},"id":"b1-u05-q05"},{"type":"translation-choice","kind":"choice","prompt":"选出下面句子的正确中文意思：\nAnd you?","hint":"","options":["柠檬水！","你呢？","您想试试吗？","是这些吗？"],"answer":1,"explain":"And you? — 你呢？","source":{"kind":"sentence","en":"And you?"},"id":"b1-u05-q06"}],"grammar":[{"title":"How are you? 询问身体状况句型","definition":"How are you? 是英语中询问他人身体或状况的常用问候语，属于特殊疑问句","structure":"How + am/is/are + 主语 + (today)?","usage":"用于日常问候，可根据对象选择 am/is/are","examples":[{"en":"How are you today?","zh":"你今天好吗？"},{"en":"How is he?","zh":"他好吗？"},{"en":"How are they?","zh":"他们好吗？"}]},{"title":"Be动词引导的一般疑问句","definition":"将 Be 动词（am/is/are）提前到句首构成的疑问句，必须用 Yes 或 No 回答","structure":"Am/Is/Are + 主语 + 形容词/副词?","usage":"用于询问某人或某物的状态、状况","examples":[{"en":"Are you well today?","zh":"你今天身体好吗？"},{"en":"Is Emma fine?","zh":"Emma 好吗？"}]},{"title":"Too 的用法","definition":"too 是副词，意为\"也\"，用于肯定句末，通常用逗号与前文隔开","structure":"主语 + 动词 + 其他 + too.","usage":"表示与前面提到的情况相同，用于肯定句和疑问句的肯定回答后","examples":[{"en":"I'm well, and she's well too.","zh":"我很好，她也很好。"},{"en":"Nice to see you too.","zh":"也很高兴见到你。"}]}],"patterns":[{"pattern":"How are you today?","explanation":"","original":{"en":"How are you today?","zh":"你今天好吗？"},"examples":[{"en":"How are you tomorrow?","zh":"你明天好吗？"},{"en":"How are you this morning?","zh":"你今天上午好吗？"}]},{"pattern":"I'm + 形容词","explanation":"","original":{"en":"I'm very well, thank you.","zh":"我非常好，谢谢你。"},"examples":[{"en":"I'm fine, thanks.","zh":"我很好，谢谢。"},{"en":"I'm not bad.","zh":"我还不错。"}]},{"pattern":"How is + 人名?","explanation":"","original":{"en":"How is Emma?","zh":"Emma 好吗？"},"examples":[{"en":"How is Tom?","zh":"Tom 好吗？"},{"en":"How is your mother?","zh":"你妈妈好吗？"}]},{"pattern":"Nice to see you","explanation":"","original":{"en":"Nice to see you.","zh":"很高兴见到你。"},"examples":[{"en":"Nice to see you again.","zh":"很高兴再次见到你。"},{"en":"Nice to see you too.","zh":"我也很高兴见到你。"}]}]}
