{"id":"b1-u06","contentId":"nce1:u06","book":1,"unit":6,"key":"011-012","lessonFrom":11,"lessonTo":12,"title":"Is This Your Shirt","titleZh":"这是你的衬衫吗？","question":"Whose shirt is white?","vocab":[{"word":"shirt","phonetic":"/ʃɜːt/","meanings":[{"pos":"noun","meaning":"衬衫","usage":"指上身穿着的衬衫，通常指男式衬衫"}]},{"word":"whose","phonetic":"/huːz/","meanings":[{"pos":"pronoun","meaning":"谁的","usage":"用于询问某物属于谁，是who的所有格形式"}]},{"word":"perhaps","phonetic":"/pəˈhæps/","meanings":[{"pos":"adverb","meaning":"可能，或许","usage":"表示不确定或可能性"}]},{"word":"white","phonetic":"/waɪt/","meanings":[{"pos":"adjective","meaning":"白色的","usage":"描述颜色"}]},{"word":"blue","phonetic":"/bluː/","meanings":[{"pos":"adjective","meaning":"蓝色的","usage":"描述颜色"}]},{"word":"catch","phonetic":"/kætʃ/","meanings":[{"pos":"verb","meaning":"接住，抓住","usage":"指接住扔过来的东西"}]},{"word":"sir","phonetic":"/sɜː/","meanings":[{"pos":"noun","meaning":"先生","usage":"对男士的尊称，常用于服务行业"}]},{"word":"Tim","phonetic":"/tɪm/","meanings":[{"pos":"noun","meaning":"蒂姆（人名）","usage":"人名"}]},{"word":"Dave","phonetic":"/deɪv/","meanings":[{"pos":"noun","meaning":"戴夫（人名）","usage":"人名，David的昵称"}]},{"word":"here","phonetic":"/hɪə/","meanings":[{"pos":"adverb","meaning":"这里，这里来","usage":"表示地点或方向"}]}],"phrases":[{"phrase":"Whose shirt is that?","usage":"用于询问那件衬衫是谁的","examples":[{"en":"Whose shirt is that?","zh":"那件衬衫是谁的？"}]},{"phrase":"Is this your shirt?","usage":"用于询问某件衬衫是否属于对方","examples":[{"en":"Is this your shirt, Dave?","zh":"这是你的衬衫吗，戴夫？"}]},{"phrase":"Perhaps it is","usage":"表示不确定的肯定回答，意为'可能是'","examples":[{"en":"Is this shirt Tim's? Perhaps it is.","zh":"这是蒂姆的衬衫吗？可能是。"}]},{"phrase":"Here you are","usage":"递东西给他人时的常用表达","examples":[{"en":"Here you are. Catch!","zh":"给你，接住！"}]},{"phrase":"Tim's shirt","usage":"名词所有格，表示蒂姆的衬衫","examples":[{"en":"Tim's shirt is white.","zh":"蒂姆的衬衫是白色的。"}]},{"phrase":"My shirt's blue","usage":"口语中's可以代替is，表示我的衬衫是蓝色的","examples":[{"en":"My shirt's blue.","zh":"我的衬衫是蓝色的。"}]}],"sentenceCount":16,"exerciseCount":6,"grammarCount":3,"patternCount":3,"sentences":[{"en":"Whose shirt is that?","zh":"那是谁的衬衫？","t":17.18},{"en":"Is this your shirt Dave?","zh":"戴夫，这是你的衬衫吗？","t":20.08},{"en":"No. Sir.","zh":"不，先生。","t":23.18},{"en":"It's not my shirt.","zh":"它不是我的衬衫。","t":24.58},{"en":"This is my shirt.","zh":"这是我的衬衫。","t":27.86},{"en":"My shirt's blue.","zh":"我的衬衫是蓝色的。","t":30.45},{"en":"Is this shirt Tim's?","zh":"这件衬衫是蒂姆的吗？","t":33.31},{"en":"Perhaps it is sir.","zh":"也许是，先生。","t":36.52},{"en":"Tim's shirt's white.","zh":"蒂姆的衬衫是白色的。","t":39.51},{"en":"Tim!","zh":"蒂姆！","t":42.22},{"en":"Yes sir?","zh":"是，先生？","t":43.78},{"en":"Is this your shirt?","zh":"这是你的衬衫吗？","t":45.35},{"en":"Yes sir.","zh":"是的，先生。","t":47.38},{"en":"Here you are.","zh":"给你。","t":48.8},{"en":"Catch!","zh":"接住！","t":50.45},{"en":"Thank you sir.","zh":"谢谢您，先生。","t":51.54}],"exercises":[{"type":"vocab-choice","kind":"choice","prompt":"“戴夫（人名）” 对应的单词是？","hint":"noun · /deɪv/","options":["nuisance","speed","terrible","Dave"],"answer":3,"explain":"Dave · /deɪv/ · noun · 戴夫（人名）。人名，David的昵称","source":{"kind":"vocab","word":"Dave"},"id":"b1-u06-q01"},{"type":"spell","kind":"text","prompt":"根据释义和音标拼写单词：可能，或许","hint":"/pəˈhæps/ · adverb","answer":"perhaps","placeholder":"输入英文单词","explain":"perhaps · /pəˈhæps/ · adverb · 可能，或许。表示不确定或可能性","source":{"kind":"vocab","word":"perhaps"},"id":"b1-u06-q02"},{"type":"phrase-fill","kind":"text","prompt":"补全短语：_____ is white.","hint":"蒂姆的衬衫是白色的。","answer":"Tim's shirt","placeholder":"输入缺失的短语","explain":"Tim's shirt：名词所有格，表示蒂姆的衬衫（蒂姆的衬衫是白色的。）","source":{"kind":"phrase","phrase":"Tim's shirt"},"id":"b1-u06-q03"},{"type":"cloze","kind":"text","prompt":"补全句子：Is this your shirt _____","hint":"戴夫，这是你的衬衫吗？","answer":"Dave","placeholder":"输入缺失的单词","explain":"Is this your shirt Dave? — 戴夫，这是你的衬衫吗？","source":{"kind":"sentence","en":"Is this your shirt Dave?"},"id":"b1-u06-q04"},{"type":"grammar-choice","kind":"choice","prompt":"“Whose是疑问代词，用来询问某物属于谁” 描述的是哪个语法点？","hint":"Whose + 名词 + is/are + 主语/地点?","options":["Where引导的特殊疑问句","否定句（be动词的否定形式）","Whose 引导的特殊疑问句","一般疑问句的简略回答"],"answer":2,"explain":"Whose 引导的特殊疑问句：Whose + 名词 + is/are + 主语/地点?：当需要询问某物的所属时使用","source":{"kind":"grammar","title":"Whose 引导的特殊疑问句"},"id":"b1-u06-q05"},{"type":"translation-choice","kind":"choice","prompt":"选出下面句子的正确中文意思：\nPerhaps it is sir.","hint":"","options":["不，它们不是。","他叫卡洛斯。","也许是，先生。","“今天上午汤米已经上过三次厕所了，但我还没见到有任何‘零钱’呢！”"],"answer":2,"explain":"Perhaps it is sir. — 也许是，先生。","source":{"kind":"sentence","en":"Perhaps it is sir."},"id":"b1-u06-q06"}],"grammar":[{"title":"Whose 引导的特殊疑问句","definition":"Whose是疑问代词，用来询问某物属于谁","structure":"Whose + 名词 + is/are + 主语/地点?","usage":"当需要询问某物的所属时使用","examples":[{"en":"Whose shirt is that?","zh":"那件衬衫是谁的？"},{"en":"Whose book is this?","zh":"这是谁的书？"}]},{"title":"Is this/that + 所有格 + 名词? 句型","definition":"用于询问某物是否属于某人","structure":"Is this/that + 限定词 + 名词 + (名词所有格)?","usage":"询问物品的归属时使用，回答用Yes或No","examples":[{"en":"Is this your shirt?","zh":"这是你的衬衫吗？"},{"en":"Is this shirt Tim's?","zh":"这件衬衫是蒂姆的吗？"}]},{"title":"名词所有格","definition":"在名词后加's表示所属关系","structure":"名词 + 's","usage":"表示某人拥有某物，用于人名后","examples":[{"en":"Tim's shirt is white.","zh":"蒂姆的衬衫是白色的。"},{"en":"This is Dave's shirt.","zh":"这是戴夫的衬衫。"}]}],"patterns":[{"pattern":"Whose + 名词 + is + this/that?","explanation":"","original":{"en":"Whose shirt is that?","zh":"那件衬衫是谁的？"},"examples":[{"en":"Whose coat is this?","zh":"这件外套是谁的？"},{"en":"Whose car is that?","zh":"那辆车是谁的？"}]},{"pattern":"Is this/that + your/名词所有格 + 名词?","explanation":"","original":{"en":"Is this your shirt, Dave?","zh":"这是你的衬衫吗，戴夫？"},"examples":[{"en":"Is that your car?","zh":"那是你的车吗？"},{"en":"Is this Tim's book?","zh":"这是蒂姆的书吗？"}]},{"pattern":"Here you are.","explanation":"","original":{"en":"Here you are.","zh":"给你。"},"examples":[{"en":"Here you are. Catch!","zh":"给你，接住！"},{"en":"Here is your coffee.","zh":"这是你的咖啡。"}]}]}
