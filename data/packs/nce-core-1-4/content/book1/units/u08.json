{"id":"b1-u08","contentId":"nce1:u08","book":1,"unit":8,"key":"015-016","lessonFrom":15,"lessonTo":16,"title":"Your Passports, Please","titleZh":"请出示您的护照。","question":"Is there a problem with the Customs officer?","vocab":[{"word":"passport","phonetic":"/ˈpɑːspɔːt/","meanings":[{"pos":"noun","meaning":"护照","usage":"出国时证明身份的官方文件"}]},{"word":"customs","phonetic":"/ˈkʌstəmz/","meanings":[{"pos":"noun","meaning":"海关","usage":"政府设在边境检查货物和证件的机构"}]},{"word":"officer","phonetic":"/ˈɒfɪsə(r)/","meanings":[{"pos":"noun","meaning":"官员；军官","usage":"在海关或军队中担任职务的人"}]},{"word":"tourist","phonetic":"/ˈtʊərɪst/","meanings":[{"pos":"noun","meaning":"游客；旅行者","usage":"以观光为目的的人"}]},{"word":"brown","phonetic":"/braʊn/","meanings":[{"pos":"adj","meaning":"棕色的；褐色的","usage":"描述颜色"}]},{"word":"Danish","phonetic":"/ˈdeɪnɪʃ/","meanings":[{"pos":"adj/noun","meaning":"丹麦的；丹麦人/语","usage":"表示丹麦国籍或语言"}]},{"word":"Swedish","phonetic":"/ˈswiːdɪʃ/","meanings":[{"pos":"adj/noun","meaning":"瑞典的；瑞典人/语","usage":"表示瑞典国籍或语言"}]},{"word":"Norwegian","phonetic":"/nɔːˈwiːdʒən/","meanings":[{"pos":"adj/noun","meaning":"挪威的；挪威人/语","usage":"表示挪威国籍或语言"}]},{"word":"friend","phonetic":"/frend/","meanings":[{"pos":"noun","meaning":"朋友","usage":"认识并关系好的人"}]},{"word":"case","phonetic":"/keɪs/","meanings":[{"pos":"noun","meaning":"箱子；盒子","usage":"装行李的容器，也指具体情况"}]},{"word":"here","phonetic":"/hɪə(r)/","meanings":[{"pos":"adv","meaning":"这里；在这里","usage":"指示地点"}]},{"word":"our","phonetic":"/ˈaʊə(r)/","meanings":[{"pos":"det","meaning":"我们的","usage":"we的所有格形式"}]}],"phrases":[{"phrase":"Your passports please","usage":"请出示护照，是海关检查时的常用语","examples":[{"en":"Your passports please.","zh":"请出示你们的护照。"}]},{"phrase":"Here they are","usage":"递东西时的表达，意思是'给你'","examples":[{"en":"Here they are.","zh":"给你。"}]},{"phrase":"That's fine","usage":"表示一切正常，可以通行","examples":[{"en":"That's fine. Thank you very much.","zh":"没问题。非常感谢。"}]},{"phrase":"Are you Swedish?","usage":"询问国籍的句型","examples":[{"en":"Are you Swedish?","zh":"你是瑞典人吗？"}]},{"phrase":"