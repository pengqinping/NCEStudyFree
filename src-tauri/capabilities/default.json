{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "NCE StudyFree 默认权限：核心 API + 资源包文件读写 + 目录下载",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "http:default"
  ]
}
